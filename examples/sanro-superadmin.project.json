{
  "schemaVersion": 1,
  "project": "SANRO Superadmin",
  "projectType": "node",
  "minimumNodeMajor": 20,
  "requiredTools": ["git", "node", "npm", "rg"],
  "optionalTools": ["fd", "ast-grep"],
  "dependencyCommands": [
    {
      "name": "backend npm ci",
      "workingDirectory": "backend",
      "command": "npm.cmd",
      "args": ["ci", "--no-audit", "--no-fund"]
    }
  ],
  "fullTest": {
    "workingDirectory": "backend",
    "command": "npm.cmd",
    "args": ["test"]
  },
  "focusedTest": {
    "workingDirectory": "backend",
    "command": "node",
    "args": ["--test", "test/{filter}*.test.js"]
  },
  "handoff": {
    "agentsFile": "AGENTS.md",
    "workboard": "docs/SUPERADMIN_WORKBOARD.md",
    "checkpoint": "docs/CHECKPOINT_V0_3_8_WIP.md",
    "rules": [
      "SANRO_DEVELOPMENT_RULES.md",
      "SUPERADMIN_PROJECT_OPERATING_RULES.md"
    ],
    "remoteIsSourceOfTruth": true,
    "recentCommitCount": 8
  },
  "security": {
    "includeSecretsInRecoveryArchive": false
  }
}
