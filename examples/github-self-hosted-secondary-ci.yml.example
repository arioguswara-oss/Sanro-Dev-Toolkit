# OPTIONAL secondary integration only.
# Copy/adapt this file into a repository's .github/workflows/ directory only
# when GitHub-triggered verification is useful. SANRO Local CI must remain
# runnable directly on the SANRO VPS without GitHub.

name: SANRO Local CI - Secondary GitHub Trigger

on:
  workflow_dispatch:
  pull_request:

permissions:
  contents: read

jobs:
  sanro-local-ci:
    runs-on: [self-hosted, linux, sanro]
    steps:
      - name: Checkout source
        uses: actions/checkout@v4

      - name: Run the same SANRO CI engine used outside GitHub
        shell: bash
        run: |
          /opt/sanro/toolkit/sanro-dev.sh ci \
            -ProjectRoot "$GITHUB_WORKSPACE" \
            -Json

# Important:
# - This workflow is not the SANRO CI control plane.
# - Do not put unique build/test logic here; keep it in sanro-dev.project.json.
# - A GitHub outage/quota/billing failure must not prevent running the same
#   command directly on the SANRO VPS.
# - This workflow never grants production deployment approval.
