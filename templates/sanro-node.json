{
  "schemaVersion": 1,
  "project": "SANRO Node Project",
  "projectType": "sanro-node",
  "minimumNodeMajor": 20,
  "requiredTools": ["git", "node", "npm", "rg"],
  "optionalTools": ["fd", "ast-grep"],
  "dependencyCommands": [
    {
      "name": "npm ci",
      "workingDirectory": ".",
      "command": "npm",
      "args": ["ci", "--no-audit", "--no-fund"]
    }
  ],
  "fullTest": {
    "workingDirectory": ".",
    "command": "npm",
    "args": ["test"]
  },
  "focusedTest": {
    "workingDirectory": ".",
    "command": "node",
    "args": ["--test", "test/{filter}*.test.js"]
  },
  "handoff": {
    "agentsFile": "AGENTS.md",
    "workboard": "",
    "checkpoint": "",
    "rules": [],
    "remoteIsSourceOfTruth": true,
    "recentCommitCount": 8
  },
  "security": {
    "includeSecretsInRecoveryArchive": false
  },
  "sanro": {
    "codexReady": true,
    "focusedFirst": true,
    "fullRegressionNearBatchEnd": true,
    "remoteEvidenceRequired": true
  }
}
