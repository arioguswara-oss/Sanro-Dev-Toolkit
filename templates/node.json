{
  "schemaVersion": 1,
  "project": "Node Project",
  "projectType": "node",
  "minimumNodeMajor": 20,
  "requiredTools": ["git", "node", "npm", "rg"],
  "optionalTools": ["fd", "ast-grep"],
  "dependencyCommands": [
    {
      "name": "npm ci",
      "workingDirectory": ".",
      "command": "npm",
      "args": ["ci", "--no-audit", "--no-fund"]
    }
  ],
  "fullTest": {
    "workingDirectory": ".",
    "command": "npm",
    "args": ["test"]
  },
  "focusedTest": {
    "workingDirectory": ".",
    "command": "node",
    "args": ["--test", "test/{filter}*.test.js"]
  },
  "security": {
    "includeSecretsInRecoveryArchive": false
  }
}
