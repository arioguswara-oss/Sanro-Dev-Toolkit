{
  "schemaVersion": 1,
  "project": "Generic Project",
  "projectType": "generic",
  "minimumNodeMajor": null,
  "requiredTools": ["git", "rg"],
  "optionalTools": ["fd", "ast-grep"],
  "dependencyCommands": [],
  "fullTest": null,
  "focusedTest": null,
  "ci": {
    "reportDirectory": ".sanro-ci",
    "failFast": false,
    "dependencyPolicy": {
      "installMode": "explicit-only",
      "allowCiInstall": false
    },
    "pipeline": ["check"],
    "stages": {
      "check": {
        "enabled": true,
        "required": true,
        "builtin": "fast-check"
      }
    },
    "artifactOutputs": [],
    "releaseValidation": {
      "requireCleanWorkingTree": true,
      "requireArtifacts": false,
      "enforceProductionApproval": true
    },
    "healthCheck": {
      "mode": "project-defined",
      "command": null
    },
    "deploymentPolicy": {
      "productionApprovalRequired": true,
      "autoDeploy": false
    },
    "rollbackPolicy": {
      "approvalRequired": true,
      "mode": "project-defined",
      "command": null
    }
  },
  "security": {
    "includeSecretsInRecoveryArchive": false
  }
}
